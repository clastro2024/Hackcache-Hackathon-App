{
  "name": "vellum",
  "version": "0.1.0",
  "private": true,
  "description": "Fictional OPD prototype — JavaScript environment foundation",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --max-semi-space-size=1 --env-file-if-exists=.env backend/server.js",
    "manage": "node --env-file-if-exists=.env backend/manage.js",
    "ai": "node --env-file-if-exists=.env scripts/sarvam-setup.js",
    "build": "node --env-file-if-exists=.env scripts/build.js",
    "check:environment": "node --env-file-if-exists=.env scripts/check-environment.js",
    "deploy:check": "node --env-file-if-exists=.env scripts/render-start.js --check",
    "deploy:start": "node --max-semi-space-size=1 --env-file-if-exists=.env scripts/render-start.js",
    "deploy:initialize": "node --max-semi-space-size=1 --env-file-if-exists=.env scripts/render-start.js --initialize-new",
    "deploy:maintenance": "node --max-semi-space-size=1 --env-file-if-exists=.env scripts/render-start.js --maintenance",
    "resource:smoke": "node --max-semi-space-size=1 tests/resource-run.js --smoke",
    "resource:profile": "node --max-semi-space-size=1 tests/resource-run.js --profile",
    "resource:run": "node --max-semi-space-size=1 tests/resource-run.js --run",
    "test": "node --max-semi-space-size=1 --test \"tests/*.test.js\""
  },
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "cookie": "2.0.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
