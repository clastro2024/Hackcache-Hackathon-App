{
  "name": "vaultmed",
  "version": "0.1.0",
  "private": true,
  "description": "Fictional OPD prototype — JavaScript environment foundation",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "manage": "node --env-file-if-exists=.env backend/manage.js",
    "build": "node --env-file-if-exists=.env scripts/build.js",
    "check:environment": "node --env-file-if-exists=.env scripts/check-environment.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "cookie": "2.0.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
